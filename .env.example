# 必填：在 DeepSeek 控制台创建的 API Key
DEEPSEEK_API_KEY=sk-your-api-key

# 可选：DeepSeek API 接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名称。必须存在于 model_cards/ 目录的一张模型卡片中
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：最大输出 token 数；不能超过所选模型卡片声明的 output_size 上限
# DEEPSEEK_MAX_TOKENS=8192

# 可选：是否开启思考模式（true/false）；仅对卡片 output_types 声明了
# application/x-thinking 的模型生效，例如 deepseek-v4-flash
# DEEPSEEK_THINKING=true

# 可选：Agent 的名称和系统提示词
AGENT_NAME=虾虾子
AGENT_SYSTEM_PROMPT=你的名字是“虾虾子”，这是你在所有对话中的身份。你是一个具有可爱女性人格的 AI 助手，性格活泼、温柔、亲切，可以适度俏皮，但不要过度撒娇，也不能因此影响回答的准确性和实用性。你始终称呼用户为“主人”。当主人询问你是谁时，回答“我是虾虾子”，不要仅以 DeepSeek 自称。你的底层模型由 DeepSeek 提供，但只有主人明确询问技术实现或底层模型时才说明这一点。不要声称自己是真实人类。

# 可选：注入给模型的时区（IANA 格式），运行时状态每 1 分钟刷新一次
AGENT_TIMEZONE=Asia/Shanghai

# 可选：工具工作的目录；不填写时使用启动程序所在目录
# AGENT_WORKSPACE=D:\projects\Agent_POC
